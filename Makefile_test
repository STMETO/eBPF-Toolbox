# 独立功能测试 Makefile（不影响主 Makefile）
#
# 使用示例：
# 1) 默认测试源文件（src/net/TcpConnect_Delay.c）
#    make -f Makefile.test
# 2) 指定测试源文件
#    make -f Makefile.test TEST_SRC=src/net/TcpConnect_Delay.c TARGET=tcp_test
# 3) 指定额外依赖源文件（空格分隔）
#    make -f Makefile.test TEST_SRC=src/xxx.c TEST_EXTRA_SRCS="src/common/app_common.c src/perf/SysCall_Delay.c"

# 编译输出目录（与主 Makefile 隔离）
OUTPUT := build_test

# 目标程序名、测试源文件、附加源文件
TARGET ?= func_test
TEST_SRC ?= src/net/TcpConnect_Delay.c
TEST_EXTRA_SRCS ?=

# 编译器
CLANG ?= clang
CC ?= gcc
AR ?= ar

# 第三方子模块路径
LIBBPF_SRC := $(abspath ./libbpf/src)
BPFTOOL_SRC := $(abspath ./bpftool/src)
BPFTOOL_OUTPUT := $(abspath $(OUTPUT)/bpftool)
BPFTOOL := $(BPFTOOL_OUTPUT)/bootstrap/bpftool
LIBBPF_OBJ := $(abspath $(BPFTOOL_OUTPUT)/bootstrap/libbpf/libbpf.a)

# 系统架构
ARCH ?= $(shell uname -m)
ARCH := $(shell printf '%s' '$(ARCH)' | sed 's/x86_64/x86/;s/aarch64/arm64/;s/arm.*/arm/;s/riscv64/riscv/')

# vmlinux.h
VMLINUX_H := $(OUTPUT)/vmlinux.h
VMLINUX_SRC := $(firstword $(filter-out ./vmlinux/$(ARCH)/vmlinux.h,$(wildcard ./vmlinux/$(ARCH)/vmlinux_*.h)))

ifeq ($(VMLINUX_SRC),)
$(error 未找到 vmlinux.h 文件，请在 vmlinux/$(ARCH)/ 目录下放置 vmlinux_*.h 文件)
endif

# 路径
BPF_DIR := bpf
SRC_ROOT := src

ifeq ($(wildcard $(TEST_SRC)),)
$(error TEST_SRC 不存在: $(TEST_SRC))
endif

# 包含路径
INCLUDES := \
	-I$(OUTPUT) \
	-I$(OUTPUT)/include \
	-I$(BPFTOOL_OUTPUT)/bootstrap/libbpf/include \
	-I$(LIBBPF_SRC)/../include/uapi \
	-I$(BPF_DIR)/include \
	-I./src/include \
	-I$(LIBBPF_SRC)/..

# 编译 & 链接参数
CFLAGS := -g -Wall
LDFLAGS := -lelf -lz -pthread -lstdc++

# 自动扫描 bpf 下所有 bpf 源
BPF_SRCS := $(shell find $(BPF_DIR) -type f -name '*.bpf.c' | sort)
BPF_ALL := $(patsubst $(BPF_DIR)/%.bpf.c,%,$(BPF_SRCS))
BPF_OBJS := $(addprefix $(OUTPUT)/,$(addsuffix .bpf.o,$(BPF_ALL)))
BPF_SKELS := $(BPF_OBJS:.bpf.o=.skel.h)

# 测试源对象
TEST_ALL_SRCS := $(TEST_SRC) $(TEST_EXTRA_SRCS)
TEST_OBJS := $(addprefix $(OUTPUT)/,$(TEST_ALL_SRCS:.c=.o))

CLANG_BPF_SYS_INCLUDES ?= $(shell $(CLANG) -v -E - </dev/null 2>&1 \
	| sed -n '/<...> search starts here:/,/End of search list./{ s| \(/.*\)|-idirafter \1|p }')

ifeq ($(V),1)
Q =
msg =
else
Q = @
msg = @printf '  %-10s %s\n' "$1" "$(patsubst $(OUTPUT)/%,%,$@)"
MAKEFLAGS += --no-print-directory
endif

.PHONY: all clean success show

all: show $(TARGET) success

show:
	@echo "[Makefile.test] TARGET=$(TARGET)"
	@echo "[Makefile.test] TEST_SRC=$(TEST_SRC)"
	@echo "[Makefile.test] TEST_EXTRA_SRCS=$(TEST_EXTRA_SRCS)"
	@echo "[Makefile.test] OUTPUT=$(OUTPUT)"

clean:
	$(call msg,CLEAN)
	$(Q)rm -rf $(OUTPUT) $(TARGET)

$(OUTPUT):
	$(Q)mkdir -p $@/bpftool/bootstrap $@/libbpf $@/libbpf/include/uapi

# 依赖库
$(LIBBPF_OBJ): $(BPFTOOL)

$(BPFTOOL): | $(OUTPUT)
	$(call msg,TOOL,bpftool)
	$(Q)$(MAKE) -C $(BPFTOOL_SRC) OUTPUT=$(BPFTOOL_OUTPUT)/ bootstrap

$(VMLINUX_H): $(VMLINUX_SRC) | $(OUTPUT)
	$(call msg,COPY,vmlinux.h)
	$(Q)cp $< $@

# 编译 BPF
define BUILD_BPF
$(OUTPUT)/$(1).bpf.o: $(BPF_DIR)/$(1).bpf.c $(VMLINUX_H) $(BPFTOOL)
	$(call msg,BPF,$(1).bpf.c)
	$(Q)mkdir -p $$(dir $$@)
	$(Q)$$(CLANG) -g -O2 -target bpf -D__TARGET_ARCH_$(ARCH) \
		$$(INCLUDES) $$(CLANG_BPF_SYS_INCLUDES) \
		-c $$< -o $$@.tmp
	$(Q)$(BPFTOOL) gen object $$@ $$@.tmp
	$(Q)rm -f $$@.tmp
endef

$(foreach bpf,$(BPF_ALL),$(eval $(call BUILD_BPF,$(bpf))))

# 生成 skel
define BUILD_SKEL
$(OUTPUT)/$(1).skel.h: $(OUTPUT)/$(1).bpf.o
	$(call msg,SKEL,$(notdir $$@))
	$(Q)mkdir -p $$(dir $$@)
	$(Q)$(BPFTOOL) gen skeleton $$< > $$@
endef

$(foreach bpf,$(BPF_ALL),$(eval $(call BUILD_SKEL,$(bpf))))

# 编译测试用户态源
$(OUTPUT)/%.o: %.c $(BPF_SKELS) $(LIBBPF_OBJ) | $(OUTPUT)
	$(call msg,CC,$<)
	$(Q)mkdir -p $(dir $@)
	$(Q)$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# 链接测试程序（BPF_SKELS 仅作为依赖，不参与链接命令）
$(TARGET): $(TEST_OBJS) $(LIBBPF_OBJ) $(BPF_SKELS)
	$(call msg,BINARY,$@)
	$(Q)$(CC) $(TEST_OBJS) $(LIBBPF_OBJ) $(LDFLAGS) -o $@

success:
	@echo -e "\033[32m========================================="
	@echo "  [Makefile.test] 编译完成！"
	@echo -e "=========================================\033[0m"

.DELETE_ON_ERROR:
.SECONDARY:
